{
  "name": "ulysesdock",
  "productName": "UlysesDock",
  "version": "1.0.1",
  "description": "Side-docked Jira + Bitbucket work monitor for the Ulyses team",
  "main": "src/main.js",
  "author": "Yacine Benakmoume",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yacinebenak/ulysesdock.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.septeo.ulysesdock",
    "productName": "UlysesDock",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "yacinebenak",
      "repo": "ulysesdock"
    }
  }
}
